# ====================================================================
# RMS BACKEND - ENVIRONMENT VARIABLES
# Copy cac bien nay vao .env.local (local) hoac Environment (Render)
# ====================================================================

# --- Database (bat buoc) ---
# Local: de mac dinh trong application.properties
# Render: SPRING_DATASOURCE_URL = jdbc:postgresql://<host>:5432/<db> (chuyen tu Internal URL cua Render)
DB_URL=jdbc:postgresql://localhost:5432/swp
DB_USERNAME=postgres
DB_PASSWORD=your-local-db-password

# --- Google OAuth2 (bat buoc) ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxx

# --- Gemini AI - chatbot (bat buoc cho chatbot AI) ---
# Key tu https://aistudio.google.com/apikey - phai bat dau bang "AIza"
GEMINI_API_KEY=AIza...

# --- Email Gmail SMTP (can cho OTP + xac nhan dat ban) ---
# App Password 16 ky tu: myaccount.google.com > Security > 2-Step Verification > App passwords
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=abcdefghijklmnop

# --- CORS + Redirect URLs (bat buoc khi deploy) ---
# Local mac dinh: http://localhost:3000 / http://localhost:8080
CORS_ALLOWED_ORIGINS=https://your-fe.onrender.com
FRONTEND_URL=https://your-fe.onrender.com
APP_BASE_URL=https://your-be.onrender.com

# --- Session cookie cho HTTPS cross-domain (deploy) ---
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true

# --- Demo data seeder (KHONG BAT tren production!) ---
SEED_DATA=false

# --- PayOS (can cho thanh toan that) ---
PAYOS_CLIENT_ID=your-client-id
PAYOS_API_KEY=your-api-key
PAYOS_CHECKSUM_KEY=your-checksum-key

# --- Upload ---
# Render Disk: /var/data/uploads ; neu khong co disk thi file mat khi redeploy
UPLOAD_DIR=./uploads

# --- AWS S3 (tuy chon - uu tien hon local disk) ---
# AWS_S3_ACCESS_KEY=
# AWS_S3_SECRET_KEY=
